.large-tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;gap:12rpx;align-items:center;padding:8rpx 24rpx;padding-bottom:calc(8rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e4e1ec}.large-tab-item{box-sizing:border-box;flex:1;min-height:88rpx;margin:0;padding:16rpx 12rpx;border-radius:16rpx;background:transparent;color:#777385;font-size:32rpx;font-size:max(32rpx,16px);line-height:1.75}.large-tab-item::after{border:0}.large-tab-item.selected{background:#eeE9fb;color:#6047bd;font-weight:600}
