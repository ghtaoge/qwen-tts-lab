.settings-page{padding:32rpx 28rpx 60rpx}.page-heading{font-size:42rpx;font-size:max(42rpx,21px);font-weight:650;color:#28253a;line-height:1.4}.page-description{font-size:28rpx;font-size:max(28rpx,14px);color:#696477;line-height:1.7;margin:14rpx 0 30rpx}.settings-card{background:#fff;border:1rpx solid #e5e1ed;border-radius:24rpx;padding:30rpx 26rpx}.field-label{display:block;font-size:32rpx;font-size:max(32rpx,16px);color:#393146;font-weight:500;margin:30rpx 0 16rpx}.field-label:first-child{margin-top:0}.settings-card input{width:100%;box-sizing:border-box;border:1rpx solid #d9d2e5;border-radius:14rpx;background:#faf9fc;height:96rpx;padding:20rpx;font-size:30rpx;font-size:max(30rpx,15px);color:#30293c;line-height:1.5}.input-placeholder{color:#8c8199;font-size:28rpx;font-size:max(28rpx,14px)}.field-hint{font-size:26rpx;font-size:max(26rpx,13px);line-height:1.7;color:#70697c;margin-top:14rpx;word-break:break-all}.error-message{font-size:28rpx;font-size:max(28rpx,14px);line-height:1.75;color:#994540;background:#fff0ee;border-radius:16rpx;padding:24rpx;margin:24rpx 0;word-break:break-all}.save-button{font-size:32rpx;font-size:max(32rpx,16px);font-weight:500;min-height:96rpx;line-height:96rpx;background:#6750bd;color:#fff;border-radius:16rpx;margin:30rpx 0 0}.save-button[disabled]{color:#e7e0f3;background:#9a8bb8}
.save-button{width:100%}
