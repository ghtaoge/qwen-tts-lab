.device-page{padding:32rpx 28rpx 144rpx}.page-heading{font-size:44rpx;font-size:max(44rpx,22px);line-height:1.35;font-weight:650;color:#28253a}.page-description{font-size:28rpx;font-size:max(28rpx,14px);line-height:1.6;color:#696477;margin:12rpx 0 28rpx}.device-card{background:#fff;border:1rpx solid #e5e1ed;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.device-top,.volume-title,.volume-caption,.settings-link,.advanced-toggle,.preference-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.device-name,.section-title{font-size:34rpx;font-size:max(34rpx,17px);font-weight:600;color:#2d283c}.connection-badge{flex-shrink:0;background:#f0edf5;color:#675f75;border-radius:30rpx;padding:9rpx 20rpx;font-size:26rpx;font-size:max(26rpx,13px);font-weight:500}.connection-badge.online{background:#e7f4ed;color:#276d4b}.device-state{font-size:30rpx;font-size:max(30rpx,15px);line-height:1.6;margin:20rpx 0 10rpx;color:#4d475e}.helper{font-size:26rpx;font-size:max(26rpx,13px);line-height:1.65;color:#70697c}.volume-title{font-size:32rpx;font-size:max(32rpx,16px);margin-top:32rpx;color:#40394f}.volume-value{font-size:38rpx;font-size:max(38rpx,19px);font-weight:600;color:#6750bd}slider{margin:30rpx 0 22rpx}.volume-caption{font-size:26rpx;font-size:max(26rpx,13px);color:#70697c}.stop-button{margin:26rpx 0 0;min-height:88rpx;line-height:88rpx;font-size:30rpx;font-size:max(30rpx,15px);color:#a04343;background:#fff0ee;border-radius:14rpx}.section-description{margin:12rpx 0 22rpx}.mode-option{display:flex;align-items:center;justify-content:space-between;text-align:left;width:100%;padding:24rpx;margin:14rpx 0 0;background:#faf9fc;border:2rpx solid #e6e2ee;border-radius:16rpx;line-height:1.5}.mode-option.selected{border-color:#8269ca;background:#f5f1ff}.mode-copy{flex:1;min-width:0}.mode-name{font-size:32rpx;font-size:max(32rpx,16px);font-weight:500;color:#363047}.mode-hint{font-size:26rpx;font-size:max(26rpx,13px);color:#70697c;margin-top:7rpx;line-height:1.5}.mode-check{width:36rpx;flex-shrink:0;text-align:center;color:#6750bd;font-size:34rpx;font-size:max(34rpx,17px)}.settings-link{width:100%;min-height:96rpx;padding:24rpx 28rpx;margin:0;background:#fff;color:#40364f;font-size:32rpx;font-size:max(32rpx,16px);line-height:1.5;border:1rpx solid #e5e1ed;border-radius:20rpx;text-align:left}.link-arrow{font-size:42rpx;font-size:max(42rpx,21px);line-height:1;color:#80758f}.error-message{padding:24rpx;background:#fff0ee;color:#994540;line-height:1.7;font-size:28rpx;font-size:max(28rpx,14px);border-radius:16rpx;margin:24rpx 0;word-break:break-all}.advanced{margin-top:24rpx;border-radius:20rpx;background:#f0edf5;overflow:hidden}.advanced-toggle{width:100%;min-height:92rpx;padding:24rpx 28rpx;text-align:left;color:#5e536e;background:transparent;font-size:30rpx;font-size:max(30rpx,15px);line-height:1.5;margin:0}.advanced-toggle text:last-child{font-size:26rpx;font-size:max(26rpx,13px);flex-shrink:0}.advanced-body{padding:0 28rpx 28rpx}.preference-row{font-size:30rpx;font-size:max(30rpx,15px);padding:26rpx 0;border-top:1rpx solid #ddd7e8;color:#3f354f}.preference-row>view{flex:1;min-width:0}.preference-row .helper{margin-top:8rpx}.preference-row switch{flex-shrink:0}.model-info{border-top:1rpx solid #ddd7e8;padding-top:26rpx;font-size:28rpx;font-size:max(28rpx,14px);line-height:1.65;color:#50445f}.model-info .helper{margin-top:8rpx}.warmup-button{margin:22rpx 0 0;border:1rpx solid #c9bedf;background:#fff;color:#6750a8;font-size:30rpx;font-size:max(30rpx,15px);line-height:88rpx;min-height:88rpx;border-radius:14rpx}.warmup-button[disabled]{color:#83788f;background:#e9e4ef}.warmup-hint{margin-top:14rpx}
.stop-button,.warmup-button{width:100%}
