.page{padding:38rpx 30rpx 0}.header,.brand,.section-title,.switch-row,.slider-label,.history-heading{display:flex;align-items:center;justify-content:space-between}.brand{justify-content:flex-start;gap:17rpx;font-size:34rpx;font-weight:600}.logo{width:66rpx;height:66rpx;line-height:66rpx;text-align:center;background:#8e7be4;border-radius:20rpx;font-size:46rpx;color:white}.eyebrow{display:block;font-size:15rpx;letter-spacing:4rpx;color:#9a9caf;margin-top:5rpx}.settings{margin:0;font-size:21rpx;padding:0 15rpx;line-height:55rpx;background:#ebe7f9;color:#8b79be;border-radius:12rpx}.intro{padding:44rpx 0 34rpx}.tag{font-size:17rpx;letter-spacing:3rpx;color:#9481d8}.title{font-size:40rpx;font-weight:600;letter-spacing:-1rpx;margin:19rpx 0}.subtitle{font-size:23rpx;color:#989eaf}.status{display:flex;align-items:center;gap:16rpx;background:#eeedf6;border:1rpx solid #e4e2ef;padding:20rpx;border-radius:17rpx;margin-bottom:25rpx}.dot{width:12rpx;height:12rpx;background:#c6a873;border-radius:50%;flex-shrink:0}.dot.online{background:#76b799}.status-copy{flex:1;font-size:23rpx}.status-copy text{font-size:18rpx;color:#a4a5b5;display:block;margin-top:7rpx}.warmup{font-size:20rpx;color:#8775bd;background:transparent;padding:0 8rpx;line-height:50rpx;margin:0}.card{background:white;border:1rpx solid #e8eaf1;border-radius:22rpx;padding:29rpx 26rpx;margin-bottom:25rpx}.section-title{font-size:25rpx;font-weight:600}.muted{font-size:19rpx;color:#a0a6b6;font-weight:400}textarea{width:100%;height:250rpx;background:#fafafd;border:1rpx solid #e6e7f0;border-radius:15rpx;padding:24rpx;font-size:28rpx;line-height:1.9;color:#5b6175;margin-top:26rpx}.examples{display:flex;align-items:center;gap:10rpx;margin-top:18rpx;font-size:18rpx;color:#aaaebc}.examples button{margin:0;font-size:18rpx;color:#9691ae;padding:0 14rpx;line-height:43rpx;background:#f7f7fb;border-radius:9rpx}.voice-title{margin:40rpx 0 25rpx}.voices{display:flex;flex-wrap:wrap;gap:12rpx}.voice{width:calc((100% - 24rpx)/3);border:1rpx