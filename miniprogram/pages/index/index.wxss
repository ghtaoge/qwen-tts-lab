.page{padding:36rpx 32rpx 144rpx}.page-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:32rpx;gap:16rpx}.page-title{font-size:44rpx;font-size:max(44rpx,22px);font-weight:650;color:#242436;line-height:1.35}.page-subtitle{font-size:28rpx;font-size:max(28rpx,14px);color:#747488;margin-top:12rpx;line-height:1.5}.connection{flex-shrink:0;display:flex;align-items:center;gap:10rpx;margin:0;padding:0 18rpx;min-height:68rpx;line-height:68rpx;background:#eeedf3;color:#686779;font-size:26rpx;font-size:max(26rpx,13px);border-radius:34rpx}.connection.connected{background:#e8f3ed;color:#36745a}.connection>text{font-size:34rpx;font-size:max(34rpx,17px);margin-left:2rpx}.status-dot{width:12rpx;height:12rpx;border-radius:50%;background:#a68b5b}.connected .status-dot{background:#47886b}.editor-card{background:#fff;border:1rpx solid #e2e1e9;border-radius:24rpx;padding:26rpx}.editor-heading{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-size:max(32rpx,16px);font-weight:600;color:#363548}.example-button{margin:0;padding:0 10rpx;font-size:26rpx;font-size:max(26rpx,13px);font-weight:400;line-height:64rpx;background:transparent;color:#6653b0}.text-input{display:block;width:100%;height:232rpx;padding:16rpx 0 0;margin-top:8rpx;font-size:34rpx;font-size:max(34rpx,17px);line-height:1.75;color:#303044;background:transparent}.input-placeholder{color:#91909e}.character-count{text-align:right;color:#797888;font-size:26rpx;font-size:max(26rpx,13px);line-height:1.5;margin-top:16rpx}.option-row{display:flex;gap:18rpx;margin-top:20rpx}.option-picker{flex:1;min-width:0}.option-cell{background:#fff;border:1rpx solid #e2e1e9;border-radius:18rpx;padding:20rpx 24rpx;min-height:116rpx}.option-label{font-size:26rpx;font-size:max(26rpx,13px);color:#777687;display:block;line-height:1.3}.option-value{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-size:max(32rpx,16px);font-weight:550;color:#363448;line-height:1.5;margin-top:7rpx;gap:10rpx}.picker-arrow{font-size:32rpx;font-size:max(32rpx,16px);color:#8e879e}.target-heading{font-size:30rpx;font-size:max(30rpx,15px);font-weight:550;margin:30rpx 0 16rpx;color:#454355}.target-picker{display:flex;padding:8rpx;background:#eae8f1;border-radius:20rpx;gap:8rpx}.target-option{flex:1;display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:80rpx;line-height:1.4;margin:0;padding:16rpx;background:transparent;color:#747080;border-radius:14rpx;font-size:32rpx;font-size:max(32rpx,16px)}.target-option.active{color:#5a45b7;background:#fff;font-weight:600;box-shadow:0 2rpx 6rpx #33245c09}.target-check{font-size:28rpx;font-size:max(28rpx,14px)}.target-note{font-size:26rpx;font-size:max(26rpx,13px);line-height:1.5;color:#787485;margin-top:14rpx;padding-left:4rpx}.primary{background:#6550c7;color:#fff;border-radius:18rpx;font-size:34rpx;font-size:max(34rpx,17px);font-weight:600;min-height:96rpx;line-height:96rpx;padding:0 24rpx;margin:28rpx 0 0}.primary[disabled]{background:#d8d3e9;color:#fff}.primary.is-busy{background:#565063}.error-message{margin-top:22rpx;padding:22rpx 24rpx;background:#fff0ed;border:1rpx solid #f2d4cf;border-radius:16rpx;color:#a04236;font-size:28rpx;font-size:max(28rpx,14px);line-height:1.65;word-break:break-word}.result-card{padding:26rpx;background:#fff;border:1rpx solid #e2e1e9;border-radius:24rpx;margin-top:30rpx}.result-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;font-size:32rpx;font-size:max(32rpx,16px);font-weight:600;color:#383547}.result-state{font-size:26rpx;font-size:max(26rpx,13px);font-weight:400;color:#4e7b64;text-align:right;max-width:65%;line-height:1.5}.result-state.working{color:#766198}.result-text{font-size:32rpx;font-size:max(32rpx,16px);line-height:1.7;color:#535064;margin-top:22rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-word}.result-meta{font-size:27rpx;font-size:max(27rpx,13.5px);color:#777385;margin-top:14rpx}.delivery-status,.stream-status,.progress-copy{font-size:28rpx;font-size:max(28rpx,14px);color:#766c93;line-height:1.6;margin-top:18rpx}.result-actions{display:flex;gap:16rpx;margin-top:24rpx}.play-button{flex:1;min-width:0;margin:0;min-height:88rpx;padding:18rpx 10rpx;line-height:1.5;background:#ede8fc;color:#5b43b7;font-size:30rpx;font-size:max(30rpx,15px);font-weight:550;border-radius:16rpx}.play-button.device-play{background:#f3f2f7;color:#615a73}.play-button[disabled]{background:#f0eff3;color:#a6a1b0}.stop-playback{font-size:28rpx;font-size:max(28rpx,14px);min-height:80rpx;line-height:80rpx;padding:0;background:transparent;color:#8c5d64;margin:12rpx 0 0}.history-link{display:flex;align-items:center;justify-content:space-between;width:100%;padding:22rpx 4rpx;margin:12rpx 0 0;min-height:88rpx;line-height:1.6;background:transparent;color:#726787;font-size:27rpx;font-size:max(27rpx,13.5px);text-align:left}.history-link text{font-size:40rpx;font-size:max(40rpx,20px);color:#9488a9;margin-left:12rpx}
.generate-button{width:100%}.text-input{border:0;outline:0}
