<view class="page">
  <view class="header"><view class="brand"><text class="logo">Q</text><view>Qwen Voice<text class="eyebrow">LOCAL AUDIO LAB</text></view></view><button class="settings" bindtap="showSettings">连接设置</button></view>
  <view class="intro"><text class="tag">QWEN3-TTS · 0.6B</text><view class="title">让文字，有自己的声音。</view><view class="subtitle">本地生成，中文音色，自在表达。</view></view>
  <view class="status"><view class="dot {{connected?'online':''}}"></view><view class="status-copy"><view>{{modelState}}</view><text>{{hardware}}</text></view><button class="warmup" loading="{{loadBusy}}" disabled="{{loadBusy || busy}}" bindtap="loadModel">预热模型</button></view>
  <view class="card"><view class="section-title"><text>01　输入文字</text><text class="muted">{{text.length}} / 300</text></view><textarea value="{{text}}" maxlength="300" bindinput="inputText" placeholder="输入想要朗读的中文…" auto-height="{{false}}"/><view class="examples"><text>试一试</text><button data-index="0" bindtap="example">清晨问候 ↗</button><button data-index="1" bindtap="example">中文发音 ↗</button></view>
    <view class="section-title voice-title"><text>02　选择音色</text><text class="muted">内置声音</text></view><view class="voices"><view wx:for="{{voices}}" wx:key="id" class="voice {{selectedVoice===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="selectVoice"><view class="avatar">{{index===0?'V':index===1?'S':index===2?'F':index===3?'D':'E'}}</view><text>{{item.name}}</text><text class="voice-description">{{item.description}}</text></view></view>
    <view class="slider-label"><text>朗读语速</text><text>{{speedLabel}}</text></view><slider min="75" max="150" step="5" value="{{speed*100}}" activeColor="#7c68d8" block-size="18" bindchange="changeSpeed"/><view class="range-label"><text>舒缓 0.75×</text><text>轻快 1.50×</text></view>
    <view class="switch-row"><view>发送到开发板<text class="small {{deviceOnline?'green':''}}">{{deviceId}} · {{deviceOnline?(deviceSimulated?'模拟接收器在线':'在线'):'离线，任务将等待领取'}}</text></view><switch checked="{{sendDevice}}" color="#7c68d8" bindchange="toggleDevice"/></view><view class="switch-row"><text>复用相同内容缓存</text><switch checked="{{useCache}}" color="#7c68d8" bindchange="toggleCache"/></view>
    <view class="switch-row"><view>首包就绪即连续试听<text class="small">提前下载下一段，不等待完整音频</text></view><switch checked="{{autoPlayParts}}" color="#7c68d8" bindchange="toggleAutoPlay"/></view>
    <button class="primary" bindtap="generate">{{busy?'■ 停止生成':'✦ 生成语音'}}</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="card"><view class="section-title"><text>03　听听效果</text><text class="muted">{{elapsed}}</text></view><view class="result-stage">{{stage}}</view><view class="metrics"><view><text>服务首包可用</text><text class="metric-value">{{result?result.firstLabel:'—'}}</text></view><view><text>推理耗时</text><text class="metric-value">{{result?result.inferenceLabel:'—'}}</text></view><view><text>手机开始试听</text><text class="metric-value">{{browserFirstLabel}}</text></view><view><text>ESP32 开始播放</text><text class="metric-value">{{result?result.deviceFirstLabel:'—'}}</text></view><view><text>音频时长</text><text class="metric-value">{{result?result.durationLabel:'—'}}</text></view><view><text>实时率 RTF</text><text class="metric-value">{{result?result.rtfLabel:'—'}}</text></view></view>
    <view class="stream-status" wx:if="{{streamStatus}}">{{streamStatus}}<button wx:if="{{playing}}" bindtap="play">停止试听</button></view><view class="result-actions"><button class="secondary" disabled="{{!result.hasParts}}" data-first="{{true}}" bindtap="play">{{playing?'停止试听':'试听首段'}}</button><button class="secondary" disabled="{{!result.audio_url}}" bindtap="play">{{playing?'停止试听':'试听完整语音'}}</button></view><view class="small">{{result.cache_hit?'本次命中缓存，不代表模型推理速度。':'首包可用不等于整段生成完成。RTF 小于 1 表示生成快于播放。'}}</view><view class="small" wx:if="{{result}}">排队：{{result.queuedLabel}} · {{result.device_delivery_simulated?'模拟接收器':'ESP32'}} 下载首包：{{result.deviceDownloadLabel}}。设备播放时间来自首次 I²S 写入确认，离线时显示 —。</view><view class="delivery" wx:if="{{result.deliveryLabel}}">{{result.deliveryLabel}}</view>
    <view class="slider-label volume-title"><text>开发板音量</text><text>{{deviceVolume}}%</text></view><slider value="{{deviceVolume}}" min="0" max="100" activeColor="#7c68d8" block-size="18" bindchange="changeVolume"/><button class="stop-device" wx:if="{{result.device_id}}" bindtap="stop">停止开发板播放</button>
  </view>
  <view class="history-heading"><text>最近生成</text><text bindtap="refreshHistory">刷新 ↻</text></view><view wx:if="{{history.length===0}}" class="empty">还没有生成记录。</view><view class="history-item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="openHistory"><text class="history-icon">▷</text><view class="history-body"><view>{{item.text}}</view><text>{{item.voiceLabel}} · {{item.statusLabel}}{{item.deliveryLabel?' · '+item.deliveryLabel:''}}</text></view><text class="chevron">›</text></view>
  <view class="footer">QWEN VOICE LAB · 本地语音实验室</view>
</view>
<view wx:if="{{settingsOpen}}" class="overlay"><view class="dialog"><view class="dialog-title">连接本地后端</view><view class="small">手机与电脑连接同一局域网。填写电脑地址，不要填写 localhost。</view><text class="field-label">后端地址</text><input value="{{baseUrl}}" data-key="baseUrl" bindinput="settingInput" placeholder="http://192.168.1.100:8766"/><text class="field-label">客户端令牌</text><input value="{{clientToken}}" password data-key="clientToken" bindinput="settingInput"/><text class="field-label">设备编号</text><input value="{{deviceId}}" data-key="deviceId" bindinput="settingInput"/><button class="primary" bindtap="saveSettings">保存并连接</button><button class="cancel-settings" bindtap="hideSettings">取消</button></view></view>
