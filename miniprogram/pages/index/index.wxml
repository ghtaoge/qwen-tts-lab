<view class="page">
  <view class="page-heading">
    <view><view class="page-title">生成语音</view><view class="page-subtitle">写一句话，选一种声音。</view></view>
    <button class="connection {{connected && (!sendDevice || deviceOnline)?'connected':''}}" bindtap="goDevice"><view class="status-dot"></view>{{connected?(sendDevice?(deviceOnline?'设备在线':'设备离线'):'已连接'):'检查连接'}}<text>›</text></button>
  </view>
  <view class="editor-card">
    <view class="editor-heading"><text>想说些什么？</text><button class="example-button" data-index="0" bindtap="example">填入示例</button></view>
    <textarea class="text-input" value="{{text}}" maxlength="300" bindinput="inputText" placeholder="输入要朗读的文字…" placeholder-class="input-placeholder" cursor-spacing="24"/>
    <view class="character-count">{{text.length}} / 300 字</view>
  </view>
  <view class="option-row">
    <picker class="option-picker" mode="selector" range="{{voices}}" range-key="name" value="{{voiceIndex}}" bindchange="changeVoice">
      <view class="option-cell"><text class="option-label">音色</text><view class="option-value">{{voiceLabel}}<text class="picker-arrow">⌄</text></view></view>
    </picker>
    <picker class="option-picker" mode="selector" range="{{speedOptions}}" value="{{speedIndex}}" bindchange="chooseSpeed">
      <view class="option-cell"><text class="option-label">语速</text><view class="option-value">{{speedLabel}}<text class="picker-arrow">⌄</text></view></view>
    </picker>
  </view>
  <view class="target-heading">在哪里播放</view>
  <view class="target-picker">
    <button class="target-option {{sendDevice?'active':''}}" data-device="{{true}}" bindtap="chooseTarget"><text class="target-check">{{sendDevice?'✓':'○'}}</text>开发板</button>
    <button class="target-option {{!sendDevice?'active':''}}" data-device="{{false}}" bindtap="chooseTarget"><text class="target-check">{{!sendDevice?'✓':'○'}}</text>手机</button>
  </view>
  <view class="target-note">{{sendDevice?'整条转换完成后，开发板自动播放':'整条转换完成后，手机自动播放'}}</view>
  <button class="primary generate-button {{busy?'is-busy':''}}" disabled="{{replayBusy || (!text.length && !busy)}}" bindtap="generate">{{busy?'停止生成':'生成语音'}}</button>
  <view class="error-message" wx:if="{{error}}">{{error}}</view>
  <view class="result-card" wx:if="{{result || busy}}">
    <view class="result-heading"><text>本次语音</text><text class="result-state {{busy?'working':''}}">{{stage}}</text></view>
    <view class="result-text" wx:if="{{result}}">{{result.text}}</view>
    <view class="result-meta" wx:if="{{result.audio_url}}">{{result.voiceName}} · {{result.durationLabel}}</view>
    <view class="progress-copy" wx:if="{{busy}}">正在转换，全部完成后自动播放。</view>
    <view class="delivery-status" wx:if="{{result.deliveryLabel}}">{{result.deliveryLabel}}</view>
    <view class="stream-status" wx:if="{{streamStatus}}">{{streamStatus}}</view>
    <view class="result-actions" wx:if="{{result}}">
      <button class="play-button" loading="{{phoneLoading}}" disabled="{{!result.audio_url || busy || phoneLoading}}" bindtap="play">{{playing?'从头重播':'手机重播'}}</button>
      <button class="play-button device-play" loading="{{replayBusy}}" disabled="{{!result.audio_url || busy || replayBusy || deviceActive}}" bindtap="replayDevice">{{deviceActive?'开发板播放中':'开发板重播'}}</button>
    </view>
    <button class="stop-playback" wx:if="{{playing || phoneLoading}}" bindtap="stopPhonePlayback">停止手机播放</button>
    <button class="stop-playback" wx:if="{{deviceActive && !busy}}" bindtap="stop">停止开发板播放</button>
  </view>
  <button class="history-link" bindtap="goHistory">以前生成的语音，去「记录」里重播<text>›</text></button>
</view>
