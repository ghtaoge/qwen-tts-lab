.page{padding:32rpx 28rpx 144rpx;color:#292d42}.page-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:32rpx}.title{font-size:46rpx;font-size:max(46rpx,23px);line-height:1.4;font-weight:650}.subtitle{display:block;font-size:28rpx;font-size:max(28rpx,14px);line-height:1.6;color:#70768a;margin-top:8rpx}.refresh-button{flex-shrink:0;min-width:112rpx;height:80rpx;line-height:80rpx;padding:0 22rpx;margin:0;background:#ece7fa;color:#6850b7;font-size:28rpx;font-size:max(28rpx,14px);border-radius:18rpx}.refresh-button[disabled]{color:#9188a8;background:#eeeaf5}.record{padding:28rpx;background:#fff;border:1rpx solid #e5e7ef;border-radius:24rpx;margin-bottom:24rpx}.record-heading,.record-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.voice-label{font-size:28rpx;font-size:max(28rpx,14px);font-weight:600;color:#655389}.time-label{font-size:26rpx;font-size:max(26rpx,13px);color:#777d8f}.record-text{font-size:32rpx;font-size:max(32rpx,16px);line-height:1.7;color:#30354a;margin:20rpx 0 22rpx;word-break:break-all;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.record-text.expanded{display:block;overflow:visible}.record-meta{font-size:28rpx;font-size:max(28rpx,14px);color:#70778c}.status{font-size:26rpx;font-size:max(26rpx,13px);color:#8b728f;background:#f6edf3;line-height:1.5;padding:6rpx 16rpx;border-radius:12rpx;white-space:nowrap}.status.ready{color:#44795e;background:#edf7f0}.record-details{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf0f5;font-size:26rpx;font-size:max(26rpx,13px);line-height:1.7;color:#72798c}.record-details>text{display:block}.detail-error{color:#ad524e;margin-top:12rpx}.record-actions{display:flex;gap:16rpx;margin-top:26rpx}.record-actions button{flex:1;min-width:0;margin:0;padding:0 12rpx;height:88rpx;line-height:88rpx;border-radius:18rpx;font-size:28rpx;font-size:max(28rpx,14px);font-weight:550;white-space:nowrap}.phone-button{color:#6850b7;background:#eee9fa}.phone-button.playing{background:#e7e0f8;color:#5838a9}.device-button{color:#fff;background:#7860d2}.record-actions button[disabled]{color:#9c98aa;background:#f0eef5}.device-status{font-size:26rpx;font-size:max(26rpx,13px);line-height:1.6;color:#6e5c99;margin-top:18rpx}.device-status.failed{color:#ac5650}.error{padding:24rpx;border-radius:18rpx;background:#fff0ed;color:#a44740;font-size:28rpx;font-size:max(28rpx,14px);line-height:1.7;word-break:break-all;margin-bottom:24rpx}.empty{background:#fff;border:1rpx solid #e5e7ef;border-radius:24rpx;text-align:center;padding:60rpx 30rpx}.empty-mark{width:96rpx;height:96rpx;line-height:96rpx;margin:0 auto 24rpx;border-radius:28rpx;background:#f0eafb;color:#8b73cc;font-size:54rpx;font-size:max(54rpx,27px)}.empty-title{font-size:34rpx;font-size:max(34rpx,17px);font-weight:600}.empty-copy{font-size:28rpx;font-size:max(28rpx,14px);line-height:1.8;color:#747b8d;margin:18rpx 0 32rpx}.empty-button{background:#7860d2;color:#fff;font-size:30rpx;font-size:max(30rpx,15px);height:88rpx;line-height:88rpx;border-radius:18rpx}.loading-copy,.list-note{text-align:center;font-size:26rpx;font-size:max(26rpx,13px);line-height:1.7;color:#777f91;padding:22rpx 0}.list-note{padding-top:8rpx}
.empty-button{width:100%}
.stop-phone{width:100%;margin:12rpx 0 0;min-height:80rpx;background:transparent;color:#8c5d64;font-size:28rpx;font-size:max(28rpx,14px);line-height:80rpx}
